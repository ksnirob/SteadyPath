generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mood {
  VERY_LOW
  LOW
  NEUTRAL
  GOOD
  GREAT
}

enum ErpStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum MedicationUnit {
  MG
  MCG
  ML
  PILL
  DROP
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  timezone      String    @default("UTC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  episodes      OcdEpisode[]
  checkIns      DailyCheckIn[]
  erpExercises  ErpExercise[]
  journalEntries JournalEntry[]
  medications   Medication[]
  habits        Habit[]
  triggerEvents TriggerEvent[]
  streaks       Streak[]
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  preferredName     String?
  emergencyContact  String?
  clinicianNotes    String?
  privacyConsentAt  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OcdEpisode {
  id                  String   @id @default(cuid())
  userId              String
  occurredAt          DateTime
  intrusiveThought    String
  trigger             String?
  compulsion          String?
  anxietyLevel        Int
  resistedCompulsion  Boolean  @default(false)
  durationMinutes     Int?
  notes               String?
  mood                Mood     @default(NEUTRAL)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, anxietyLevel])
}

model DailyCheckIn {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  anxietyLevel Int
  mood         Mood
  sleepHours   Float?
  energyLevel  Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model ErpExercise {
  id                 String    @id @default(cuid())
  userId             String
  title              String
  description        String?
  hierarchyRank      Int
  difficulty         Int
  status             ErpStatus @default(PLANNED)
  completionPercent  Int       @default(0)
  successRating      Int?
  timerSeconds       Int?
  notes              String?
  scheduledFor       DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, scheduledFor])
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime
  mood       Mood     @default(NEUTRAL)
  gratitude  String?
  wins       String?
  challenges String?
  body       String
  syncedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Medication {
  id        String         @id @default(cuid())
  userId    String
  name      String
  dose      Float?
  unit      MedicationUnit @default(MG)
  schedule  String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model Habit {
  id        String   @id @default(cuid())
  userId    String
  name      String
  target    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model TriggerEvent {
  id        String   @id @default(cuid())
  userId    String
  label     String
  context   String?
  intensity Int?
  createdAt DateTime @default(now())
  deletedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, label])
  @@index([userId, createdAt])
}

model Streak {
  id        String   @id @default(cuid())
  userId    String
  type      String
  current   Int      @default(0)
  best      Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
